# Copy to .env. Locally the database is the CMS compose stack's Postgres
# (backend/research-cms/docker-compose.yml: port 5532, database "strapi").
# In production it is the Strapi RDS database. Same database, separate "grants" schema.

# Bootstrap only (npm run db:bootstrap): the compose superuser locally, the RDS master user in production.
# Remove it from the server's .env once the schema and roles exist.
DATABASE_ADMIN_URL=postgres://strapi:strapi@localhost:5532/strapi

# Passwords the bootstrap gives the three roles. Pick long random ones in production.
GRANTS_OWNER_PASSWORD=change-me-owner
GRANTS_WORKER_PASSWORD=change-me-worker
GRANTS_READER_PASSWORD=change-me-reader

# Migrations (grants_owner), ingestion (grants_worker), read API (grants_reader). Same passwords as above.
DATABASE_OWNER_URL=postgres://grants_owner:change-me-owner@localhost:5532/strapi
DATABASE_URL=postgres://grants_worker:change-me-worker@localhost:5532/strapi
DATABASE_READER_URL=postgres://grants_reader:change-me-reader@localhost:5532/strapi

# true on RDS (TLS required), false for the local container.
DATABASE_SSL=false
