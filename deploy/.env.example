# Copy to deploy/.env on the server. Docker Compose reads it automatically for ${...} in
# docker-compose.prod.yml. No secrets here: those go in .env.cms and .env.grants.

SITE_HOST=devethicstoolkit.umd.edu
CMS_HOST=cms.devethicstoolkit.umd.edu

# "internal" until DNS points at the server (self-signed, browsers warn).
# Then your email address, which makes Caddy get real Let's Encrypt certificates.
CADDY_TLS=internal

# Image tag to run (step 5 publishes these to GHCR).
TAG=latest
