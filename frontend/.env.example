VITE_STRAPI_URL=https://your-strapi-host.example.com
# VITE_STRAPI_API_TOKEN=

# WARNING: every VITE_ variable is compiled into the public JS bundle and is
# visible to anyone who opens the site. Never put a full-access token here.
# Prefer leaving this unset and granting the Strapi Public role read-only
# (find / findOne) access to public collections. If a token is unavoidable,
# it must be a Strapi "Read-only" token.
# VITE_STRAPI_API_TOKEN=

# If your Cohorts collection plural API ID differs from `cohorts`:
# VITE_STRAPI_COHORTS_PLURAL=cohorts
