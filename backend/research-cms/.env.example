HOST=0.0.0.0
PORT=1337
# Secrets
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified


ENCRYPTION_KEY=tobemodified

# Database Connection
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SLL=
DATABASE_SSL_REJECT_UNAUTHORIZED=

DATABASE_FILENAME=
JWT_SECRET=tobemodified

# Emailing env (nodemailer). Defaults target Gmail. For local development point
# SMTP_HOST/SMTP_PORT at a mail catcher such as Mailpit (localhost:1025) and leave
# SMTP_USERNAME empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Infrastructure/aws
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=
AWS_BUCKET=
AWS_SIGNED_URL_EXPIRES=900

# Auth (see src/index.ts bootstrap)
# Public base URL of this Strapi instance, used to build OAuth redirect URIs.
PUBLIC_URL=
# Frontend origin; email-confirmation links redirect to <FRONTEND_URL>/auth/confirmed
FRONTEND_URL=
# Require new sign-ups to confirm their email: true or false. Leave empty to keep the admin-panel setting.
AUTH_EMAIL_CONFIRMATION=
# Google SSO. Leave blank to keep the provider disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend route that receives the Google access token, e.g. <FRONTEND_URL>/auth/callback/google
GOOGLE_AUTH_REDIRECT_URL=
