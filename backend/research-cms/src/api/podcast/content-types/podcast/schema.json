{
  "kind": "collectionType",
  "collectionName": "podcasts",
  "info": {
    "singularName": "podcast",
    "pluralName": "podcasts",
    "displayName": "Podcast"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "podcast_img": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "podcast_audio": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "audios"
      ]
    },
    "podcast_video": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "videos"
      ]
    },
    "title": {
      "type": "string",
      "required": true
    },
    "speaker": {
      "type": "component",
      "component": "shared.speakers",
      "repeatable": false
    },
    "release_date": {
      "type": "datetime"
    },
    "description": {
      "type": "text",
      "required": true
    }
  }
}
